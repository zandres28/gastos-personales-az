# Dirección del sitio para Caddy:
#   Producción (HTTPS automático): SITE_ADDRESS=gastos.ejemplo.com
#   Local (solo HTTP):             SITE_ADDRESS=http://localhost
SITE_ADDRESS=gastos.ejemplo.com

# Puerto HTTP/HTTPS del host -> Caddy (si el 80 lo ocupa Laragon, usa 8080/8443)
HTTP_PORT=80
HTTPS_PORT=443

# Base de datos
POSTGRES_USER=gastos
POSTGRES_PASSWORD=cambiami-una-clave-larga-y-aleatoria
POSTGRES_DB=gastos

# Secreto para los JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=cambiami-otro-secreto-largo-aleatorio-de-32-chars

# 1 = cookie Secure (producción con HTTPS). 0 solo para probar por HTTP local.
COOKIE_SECURE=1

# Solo para npm run import (borrar después de migrar)
# SUPABASE_DB_URL=postgresql://postgres.xxx:PASSWORD@db.xxx.supabase.co:5432/postgres

# --- Opcional: usar un Postgres gestionado (Supabase) en lugar del contenedor local ---
# DATABASE_URL=postgresql://postgres.<ref>:PASSWORD@aws-1-<region>.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require
#
# IMPORTANTE (SSL): el pooler de Supabase usa un certificado autofirmado. Desde
# pg-connection-string 2.14, "sslmode=require" se interpreta como "verify-full" y falla
# con SELF_SIGNED_CERT_IN_CHAIN (tanto en Vercel como en local si hay antivirus/proxy
# interceptando TLS). Agregá "uselibpqcompat=true" (o usá "sslmode=no-verify") para
# recuperar la semántica clásica de libpq: cifra la conexión sin validar la CA.
#
# Si el pooler no responde por IPv6 desde Vercel, usá el "Transaction pooler"
# (puerto 6543, host aws-1-<region>.pooler.supabase.com), no la conexión directa.
